generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ServerStatus {
  ACTIVE
  MAINTENANCE
  SUSPENDED
  INACTIVE
}

enum ServiceGroupStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ServiceStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ServerVisibilityLevel {
  NONE
  BASIC
  DETAILED
}

enum EndpointType {
  HTTP
  TCP
  PING
  KEYWORD
  OTHER
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum PaymentAttemptStatus {
  FAILED
  CANCELLED
  EXPIRED
  UNKNOWN
}

enum ActorType {
  USER
  SYSTEM
}

model User {
  id                   String     @id @default(cuid())
  name                 String
  phone                String     @unique
  email                String?    @unique
  role                 Role
  passwordHash         String     @default("")
  tokenVersion         Int        @default(0)
  lastLoginAt          DateTime?
  birthDate            DateTime?
  cooperationStartDate DateTime?
  telegramChatId       String?
  customer             Customer?
  sessions             Session[]
  auditLogs            AuditLog[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model Customer {
  id                   String         @id @default(cuid())
  userId               String         @unique
  name                 String
  displayName          String?
  phone                String?
  email                String?
  cooperationStartDate DateTime?
  telegramChatId       String?
  status               CustomerStatus @default(ACTIVE)
  serviceGroups        ServiceGroup[]
  services             Service[]
  invoices             Invoice[]
  user                 User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status])
}

model ServiceType {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int?
  services    Service[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Server {
  id               String       @id @default(cuid())
  name             String
  provider         String
  status           ServerStatus @default(ACTIVE)
  ipAddress        String?
  domain           String?
  location         String?
  cpu              String?
  ram              String?
  storage          String?
  monthlyCostToman Int?
  internalNotes    String?
  services         Service[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
}

model ServiceGroup {
  id          String             @id @default(cuid())
  customerId  String
  name        String
  description String?
  status      ServiceGroupStatus @default(ACTIVE)
  sortOrder   Int?
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  services    Service[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([customerId, status])
}

model Service {
  id                    String                @id @default(cuid())
  customerId            String
  serviceGroupId        String?
  serviceTypeId         String
  serverId              String?
  name                  String
  description           String?
  status                ServiceStatus         @default(ACTIVE)
  priceToman            Int
  startDate             DateTime
  renewalDate           DateTime
  serverVisibilityLevel ServerVisibilityLevel @default(NONE)
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceGroup          ServiceGroup?         @relation(fields: [serviceGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  serviceType           ServiceType           @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  server                Server?               @relation(fields: [serverId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  endpoints             Endpoint[]
  invoiceItems          InvoiceItem[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([customerId, status])
  @@index([serverId])
  @@index([serviceTypeId])
  @@index([renewalDate])
}

model Endpoint {
  id                  String       @id @default(cuid())
  serviceId           String
  label               String
  url                 String
  type                EndpointType
  isPublic            Boolean      @default(false)
  isActive            Boolean      @default(true)
  provider            String?
  externalMonitorId   String?
  status              String?
  uptimePercentage30d Float?
  responseTimeMs      Int?
  lastCheckedAt       DateTime?
  service             Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([serviceId, url])
  @@index([serviceId, isActive])
  @@index([serviceId, isPublic])
}

model Invoice {
  id              String        @id @default(cuid())
  customerId      String
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(UNPAID)
  subtotalToman   Int
  totalToman      Int
  issuedAt        DateTime      @default(now())
  dueDate         DateTime
  paidAt          DateTime?
  cancelledAt     DateTime?
  notes           String?
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items           InvoiceItem[]
  payment         Payment?
  paymentAttempts PaymentAttempt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([customerId, status])
  @@index([dueDate])
  @@index([createdAt])
}

model InvoiceItem {
  id                         String    @id @default(cuid())
  invoiceId                  String
  serviceId                  String?
  title                      String
  description                String?
  quantity                   Int
  unitPriceToman             Int
  totalToman                 Int
  serviceNameSnapshot        String?
  serviceTypeSnapshot        String?
  servicePriceSnapshotToman  Int?
  serviceRenewalDateSnapshot DateTime?
  invoice                    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service                    Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([invoiceId])
  @@index([serviceId])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String   @unique
  amountToman Int
  provider    String
  gatewayRef  String
  paidAt      DateTime
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, gatewayRef])
}

model PaymentAttempt {
  id          String               @id @default(cuid())
  invoiceId   String
  amountToman Int
  provider    String
  gatewayRef  String?
  status      PaymentAttemptStatus
  errorCode   String?
  errorMessage String?
  attemptedAt DateTime
  invoice     Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([invoiceId, attemptedAt])
  @@index([status])
}

model AuditLog {
  id                       String    @id @default(cuid())
  actorType                ActorType
  userId                   String?
  actorRole                Role?
  actorDisplayNameSnapshot String?
  action                   String
  entityType               String
  entityId                 String
  before                   Json?
  after                    Json?
  reason                   String?
  metadata                 Json?
  user                     User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt                DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

model InvoiceSequence {
  id        String   @id @default(cuid())
  year      Int      @unique
  lastNumber Int     @default(0)
  updatedAt DateTime @updatedAt
}
