{
  "name": "gecut-cloud",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev -- --host",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @gecut-cloud/db db:push",
    "db:studio": "turbo -F @gecut-cloud/db db:studio",
    "db:generate": "turbo -F @gecut-cloud/db db:generate",
    "db:migrate": "turbo -F @gecut-cloud/db db:migrate",
    "db:migrate:deploy": "turbo -F @gecut-cloud/db db:migrate:deploy",
    "db:seed": "turbo -F @gecut-cloud/db db:seed",
    "dev:admin": "turbo -F admin dev",
    "dev:customer-app": "turbo -F customer-app dev"
  },
  "dependencies": {
    "@gecut-cloud/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gecut-cloud/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.26.0"
}
